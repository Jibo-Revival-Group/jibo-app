<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackgrounds"
    android:paddingTop="@dimen/activity_big_margin"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.jibo.p019ui.view.proxima.CustomFontTextView
        android:textColor="@color/jibo_blue"
        android:gravity="center_vertical"
        android:id="@+id/change_password"
        android:background="@drawable/selectable_list_item_bg"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginBottom="1dp"
        android:text="United States"
        app:customFont="ProximaNova-Bold.otf"
        style="@style/Body1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:text="+1"
            style="@style/Body1"/>
        <View
            android:background="@color/pearl"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <com.jibo.p019ui.view.proxima.CustomFontEditText
            android:layout_gravity="center_vertical"
            android:id="@+id/phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:hint="(555) 123-4567"
            android:maxLength="14"
            android:digits="0123456789() -"
            android:layout_weight="1"
            android:inputType="phone"
            android:imeOptions="actionDone"
            style="@style/EditText"/>
    </LinearLayout>
</LinearLayout>
