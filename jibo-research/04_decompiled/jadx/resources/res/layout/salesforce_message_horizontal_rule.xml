<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/salesforce_horizontal_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/salesforce_message_feed_horizontal_margin"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/salesforce_message_feed_horizontal_margin"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/salesforce_message_feed_horizontal_margin"
        android:layout_marginEnd="@dimen/salesforce_message_feed_horizontal_margin"/>
    <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
        android:layout_gravity="center"
        android:id="@+id/salesforce_horizontal_rule_text"
        android:background="@color/salesforce_contrast_quaternary"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/SalesforceStyleTextTiny"/>
</FrameLayout>
