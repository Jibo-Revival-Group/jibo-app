<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selectable_list_item_bg"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/default_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/default_extended_list_item_height"
    android:minHeight="@dimen/default_extended_list_item_height">
    <ImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/avatar_size_small"
        android:layout_height="@dimen/avatar_size_small"
        android:src="@drawable/avatar_levels"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_weight="1">
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:customFont="ProximaNova-Semibold.ttf"
            style="@style/Body1"/>
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:id="@android:id/text2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            style="@style/Caption"/>
    </LinearLayout>
    <RadioButton
        android:id="@+id/compound_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/default_padding"/>
</LinearLayout>
