<?xml version="1.0" encoding="utf-8"?>
<com.salesforce.android.knowledge.p022ui.internal.views.InsetRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/knowledge_search"
    android:background="@color/salesforce_contrast_inverted"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/knowledge_search_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <android.support.v7.widget.AppCompatImageView
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/knowledge_ic_search"
            android:scaleType="center"
            android:tint="@color/salesforce_contrast_primary"/>
        <com.salesforce.android.service.common.p023ui.views.SalesforceEditText
            android:textColorHint="@color/salesforce_contrast_primary"
            android:id="@+id/knowledge_search_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/knowledge_search_hint"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/knowledge_search_header">
        <com.salesforce.android.knowledge.p022ui.internal.views.KnowledgeRecyclerView
            android:id="@+id/knowledge_search_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/knowledge_error"/>
        <include
            android:id="@+id/knowledge_search_help"
            layout="@layout/knowledge_search_help"/>
        <include
            android:id="@+id/knowledge_search_empty"
            layout="@layout/knowledge_search_empty"/>
        <include
            android:layout_gravity="center"
            android:layout_width="60dp"
            android:layout_height="60dp"
            layout="@layout/knowledge_loading_progress"/>
    </FrameLayout>
</com.salesforce.android.knowledge.p022ui.internal.views.InsetRelativeLayout>
