<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.jibo.p019ui.view.proxima.CustomFontTextView
        android:textSize="@dimen/text_size_15sp"
        android:textColor="@android:color/black"
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tips_video_margin_left_right"
        android:layout_marginTop="@dimen/tips_margin"
        android:layout_marginRight="@dimen/tips_video_margin_left_right"
        android:lineSpacingExtra="5dp"/>
    <RelativeLayout
        android:id="@+id/contentImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tips_video_margin_left_right"
            android:layout_marginTop="@dimen/tips_video_margin_top_bottom"
            android:layout_marginRight="@dimen/tips_video_margin_left_right"
            android:adjustViewBounds="true"/>
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/new_tips_5_play"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
