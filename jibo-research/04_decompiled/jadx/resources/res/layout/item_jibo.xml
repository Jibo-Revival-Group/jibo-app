<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selectable_list_item_bg"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/default_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/default_extended_list_item_height">
    <ImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/avatar_size_small"
        android:layout_height="@dimen/avatar_size_small"
        android:src="@drawable/avatar_levels"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/default_padding"
        android:layout_weight="1"
        android:layout_toRightOf="@+id/image">
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:ellipsize="marquee"
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:customFont="ProximaNova-Semibold.ttf"
            style="@style/Body1"/>
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:ellipsize="marquee"
            android:id="@android:id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            style="@style/Caption"/>
        <com.jibo.p019ui.view.proxima.CustomFontTextView
            android:ellipsize="marquee"
            android:id="@+id/loop_suspended"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/this_loop_is_suspended"
            android:maxLines="1"
            style="@style/ErrorText"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"/>
</LinearLayout>
