<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/case_generic_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:tint="?attr/cases_genericErrorImageTint"
            android:contentDescription="@null"
            app:srcCompat="?attr/cases_genericErrorImage"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
                android:gravity="center"
                android:id="@+id/case_generic_error_title"
                android:text="@string/cases_generic_error_title_text"
                style="?attr/cases_errorMessageTitleStyle"/>
            <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
                android:gravity="center"
                android:id="@+id/case_generic_error_message"
                android:text="@string/cases_generic_error_subtitle_text"
                style="?attr/cases_errorMessageSubtitleStyle"/>
        </LinearLayout>
    </LinearLayout>
</merge>
