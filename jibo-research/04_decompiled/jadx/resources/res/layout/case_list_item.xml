<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:padding="@dimen/cases_case_list_item_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
        android:id="@+id/case_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cases_case_list_item_margin_left"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ServiceCaseText.CaseItem.Time"/>
    <ImageView
        android:id="@+id/unread_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:contentDescription="@string/cases_unread_indicator_content_description"
        android:layout_marginStart="@dimen/cases_unread_indicator_margin_left"
        app:layout_constraintBottom_toTopOf="@+id/case_message"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/case_subject"
        app:layout_constraintTop_toBottomOf="@+id/case_time"
        app:srcCompat="@drawable/cases_unread_indicator"/>
    <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
        android:id="@+id/case_subject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="@dimen/cases_case_list_item_margin_left"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/case_time"
        style="@style/ServiceCaseText.CaseItem.Subject"/>
    <com.salesforce.android.service.common.p023ui.views.SalesforceTextView
        android:id="@+id/case_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="@dimen/cases_case_list_item_margin_left"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/case_subject"
        style="@style/ServiceCaseText.CaseItem.Message"/>
</android.support.constraint.ConstraintLayout>
