<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivItem"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tvItem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvItem"/>
    <com.jibo.p019ui.view.proxima.CustomFontTextView
        android:id="@+id/tvItem"
        android:paddingTop="@dimen/vertical_margin_20"
        android:paddingBottom="@dimen/vertical_margin_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_padding"
        android:paddingEnd="@dimen/dialog_padding"
        app:customFont="ProximaNova-Semibold.ttf"
        app:layout_constraintStart_toEndOf="@+id/ivItem"
        style="@style/Body1.PopUpGrey"/>
</android.support.constraint.ConstraintLayout>
