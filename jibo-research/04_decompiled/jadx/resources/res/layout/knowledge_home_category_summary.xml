<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/KnowledgeHome_ArticleList">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/knowledge_category_article_summary_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/knowledge_category_show_more_container"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="24dp">
        <com.salesforce.android.knowledge.p022ui.internal.views.ShowMoreButtonView
            android:id="@+id/knowledge_category_show_more"
            android:text="@string/knowledge_home_showMore"
            android:contentDescription="@null"
            style="@style/SalesforceButton.ShowMore"/>
    </FrameLayout>
    <include layout="@layout/knowledge_empty_category"/>
</LinearLayout>
